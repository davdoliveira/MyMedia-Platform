@page "/carrinho"
@using TP.Shared.RCL.DTOs
@using TP.Shared.RCL.Services
@inject ICarrinhoService CarrinhoService
@inject NavigationManager Navigation
@inject IEncomendasService EncomendasService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>O Meu Carrinho</PageTitle>

<div class="container my-4">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> O Meu Carrinho</h2>

    @if (!CarrinhoService.Itens.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h4>O seu carrinho está vazio!</h4>
            <p>Vá à loja e escolha alguns produtos fantásticos.</p>
            <a href="/" class="btn btn-primary mt-3">Ir para a Loja</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Produto</th>
                                    <th class="text-end">Preço</th>
                                    <th class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in CarrinhoService.Itens)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImagemUrl" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;"
                                                     onerror="this.src='/img/sem-imagem.png'" />
                                                <div>
                                                    <div class="fw-bold">@item.Titulo</div>
                                                    <small class="text-muted">@item.CategoriaNome</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold">@item.Preco.ToString("C")</td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => Remover(item)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card border-0 shadow-sm bg-light">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Resumo</h5>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span>Total (@CarrinhoService.Itens.Count itens)</span>
                            <span class="fw-bold fs-4 text-success">@CarrinhoService.Total.ToString("C")</span>
                        </div>

                        <button class="btn btn-success w-100 btn-lg" @onclick="Checkout">
                            Finalizar Encomenda <i class="bi bi-arrow-right"></i>
                        </button>

                        <a href="/" class="btn btn-link w-100 mt-2 text-decoration-none">Continuar a comprar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        // Subscrever ao evento para atualizar a página se o carrinho mudar
        CarrinhoService.OnChange += StateHasChanged;
    }

    private void Remover(ProdutoDto produto)
    {
        CarrinhoService.RemoverItem(produto);
    }

    private async Task Checkout()
    {
        // 1. Verificar se está logado
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            // Se não estiver logado, manda para o login
            Navigation.NavigateTo("/login");
            return;
        }

        // 2. Preparar os dados para envio (Converter ProdutoDto em CarrinhoItemDto)
        var itensParaEnvio = CarrinhoService.Itens.Select(i => new CarrinhoItemDto
        {
            ProdutoId = i.Id,
            Titulo = i.Titulo,
            Quantidade = 1, // Nota: Se tiveres lógica de quantidades, ajusta aqui
            PrecoUnitario = i.Preco
        }).ToList();

        // 3. Enviar para a API
        var sucesso = await EncomendasService.FinalizarEncomendaAsync(itensParaEnvio);

        if (sucesso)
        {
            // Limpar carrinho e avisar
            // (Idealmente terias um método LimparCarrinho no serviço)
            while (CarrinhoService.Itens.Any())
            {
                CarrinhoService.RemoverItem(CarrinhoService.Itens.First());
            }

            // Redirecionar para uma página de sucesso (ou home)
            Navigation.NavigateTo("/");
            // Aqui podias mostrar um "Toast" ou mensagem de sucesso
        }
        else
        {
            // Tratar erro
            Console.WriteLine("Erro ao finalizar encomenda");
        }
    }
    public void Dispose()
    {
        // Boa prática: Desligar o evento quando saímos da página
        CarrinhoService.OnChange -= StateHasChanged;
    }
}