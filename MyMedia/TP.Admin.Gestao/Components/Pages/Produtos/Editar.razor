@page "/produtos/editar/{id:int}"
@using Microsoft.EntityFrameworkCore
@using TP.Backend.Data
@using TP.Backend.Data.Entidades
@inject ApplicationDbContext Context
@inject NavigationManager Navigation

<h3>Editar Produto: @Produto?.Titulo</h3>

@if (Produto == null || ListaCategorias == null)
{
    <p><em>A carregar dados...</em></p>
}
else
{
    @if (!string.IsNullOrEmpty(MensagemErro))
    {
        <div class="alert alert-danger">@MensagemErro</div>
    }

    <div class="row">
        <div class="col-md-8">
            <EditForm Model="Produto" OnValidSubmit="AtualizarProduto" FormName="FormEditarProduto">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <input type="hidden" value="@Produto.Id" />

                <div class="row">
                    @* --- COLUNA DA ESQUERDA: DADOS GERAIS --- *@
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">Título</label>
                            <InputText class="form-control" @bind-Value="Produto.Titulo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <InputTextArea class="form-control" @bind-Value="Produto.Descricao" rows="4" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoria</label>
                            <InputSelect @bind-Value="Produto.CategoriaId" class="form-select">
                                @foreach (var cat in ListaCategorias)
                                {
                                    <option value="@cat.Id">@cat.Nome</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Modo de Entrega</label>
                            <InputSelect @bind-Value="Produto.ModoEntregaId" class="form-select">
                                @foreach (var modo in ListaModosEntrega)
                                {
                                    <option value="@modo.Id">@modo.Nome</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Imagem URL</label>
                            <InputText class="form-control" @bind-Value="Produto.ImagemUrl" />
                        </div>
                    </div>

                    @* --- COLUNA DA DIREITA: PREÇOS E ESTADO --- *@
                    <div class="col-md-6">

                        @* === BLOCO DE CÁLCULO DE PREÇO === *@
                        <div class="card p-3 mb-3 bg-light border-primary">
                            <h6 class="text-primary fw-bold">Definição de Preço</h6>

                            <div class="mb-3">
                                <label class="form-label">Preço Base (Fornecedor) €</label>
                                <InputNumber class="form-control" @bind-Value="Produto.PrecoBase" @oninput="RecalcularAoMudarBase" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Margem de Lucro (%)</label>
                                @* Usamos uma variável local para a margem para facilitar o input *@
                                <input type="number" class="form-control" value="@margemPercentagem" @onchange="RecalcularAoMudarMargem" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Preço Final (Cliente) €</label>
                                @* O Preço Final é ReadOnly porque é calculado *@
                                <InputNumber class="form-control bg-white fw-bold text-success" @bind-Value="Produto.PrecoFinal" readonly />
                            </div>
                        </div>
                        @* =================================== *@

                        <div class="mb-3">
                            <label class="form-label">Stock</label>
                            <InputNumber class="form-control" @bind-Value="Produto.Stock" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Estado Atual</label>
                            <InputSelect @bind-Value="Produto.Estado" class="form-select">
                                @foreach (var estado in Enum.GetValues(typeof(ProdutoEstado)))
                                {
                                    <option value="@estado">@estado</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="mt-3 mb-5 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Alterações
                    </button>

                    @* Botão Especial para Aprovar *@
                    <button type="button" class="btn btn-success" @onclick="AprovarEAtivar">
                        <i class="bi bi-check-circle"></i> Guardar e Aprovar (Ativar)
                    </button>

                    <a href="/produtos" class="btn btn-secondary">Cancelar</a>
                </div>
            </EditForm>
        </div>

        <div class="col-md-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-light">Pré-visualização</div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Produto.ImagemUrl))
                    {
                        <img src="@Produto.ImagemUrl" class="img-fluid rounded" style="max-height: 200px;" />
                    }
                    <h5 class="mt-3">@Produto.Titulo</h5>
                    <h3 class="text-success">@Produto.PrecoFinal.ToString("C")</h3>
                    <span class="badge bg-warning text-dark">@Produto.Estado</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public Produto? Produto { get; set; }

    private List<Categoria>? ListaCategorias;
    private List<ModoEntrega>? ListaModosEntrega;
    private string MensagemErro = "";

    // Variável auxiliar para a margem na interface
    private double margemPercentagem = 0;

    protected override async Task OnInitializedAsync()
    {
        if (Produto == null)
        {
            try
            {
                Produto = await Context.Produtos.FindAsync(Id);

                if (Produto == null)
                {
                    Navigation.NavigateTo("/produtos");
                    return;
                }

                // Calcular a margem inicial baseada nos valores que já vêm da BD
                if (Produto.PrecoBase > 0)
                {
                    // Fórmula: ((Final - Base) / Base) * 100
                    margemPercentagem = (double)((Produto.PrecoFinal - Produto.PrecoBase) / Produto.PrecoBase * 100);
                    margemPercentagem = Math.Round(margemPercentagem, 2); // Arredondar
                }

                ListaCategorias = await Context.Categorias.ToListAsync();
                ListaModosEntrega = await Context.ModosEntrega.ToListAsync();
            }
            catch (Exception ex)
            {
                MensagemErro = "Erro ao carregar dados: " + ex.Message;
            }
        }
    }

    // Recalcula o preço final quando mudamos a Margem
    private void RecalcularAoMudarMargem(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double novaMargem))
        {
            margemPercentagem = novaMargem;
            if (Produto != null)
            {
                Produto.PrecoFinal = Produto.PrecoBase + (Produto.PrecoBase * (decimal)(margemPercentagem / 100));
            }
        }
    }

    // Recalcula o preço final se mudarmos o Preço Base
    private void RecalcularAoMudarBase(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal novoBase))
        {
            if (Produto != null)
            {
                Produto.PrecoBase = novoBase;
                Produto.PrecoFinal = Produto.PrecoBase + (Produto.PrecoBase * (decimal)(margemPercentagem / 100));
            }
        }
    }

    // Método normal de guardar (mantém o estado que estiver selecionado na dropdown)
    private async Task AtualizarProduto()
    {
        await GravarNaBaseDeDados();
    }

    // Método específico para Aprovar (Muda estado para Ativo e Grava)
    private async Task AprovarEAtivar()
    {
        if (Produto != null)
        {
            Produto.Estado = ProdutoEstado.Ativo;
            // Opcional: Se tiveres a propriedade MargemLucro na entidade, guarda-a aqui
            // Produto.MargemLucro = (decimal)margemPercentagem;
            await GravarNaBaseDeDados();
        }
    }

    private async Task GravarNaBaseDeDados()
    {
        try
        {
            if (Produto != null)
            {
                // Garante que o Entity Framework sabe que os dados mudaram
                Context.Produtos.Update(Produto);
                await Context.SaveChangesAsync();
                Navigation.NavigateTo("/produtos");
            }
        }
        catch (Exception ex)
        {
            MensagemErro = "Erro ao atualizar: " + ex.Message;
        }
    }
}