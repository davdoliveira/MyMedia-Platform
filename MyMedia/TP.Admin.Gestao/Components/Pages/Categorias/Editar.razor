@page "/categorias/editar/{id:int}"
@using Microsoft.EntityFrameworkCore
@using TP.Backend.Data
@using TP.Backend.Data.Entidades
@inject ApplicationDbContext Context
@inject NavigationManager Navigation

<h3>Editar Categoria</h3>

@if (Categoria == null || ListaPossiveisPais == null)
{
    <p><em>A carregar dados...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <EditForm Model="Categoria" OnValidSubmit="AtualizarCategoria">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <input type="hidden" value="@Categoria.Id" />

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <InputText class="form-control" @bind-Value="Categoria.Nome" />
                    <ValidationMessage For="() => Categoria.Nome" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <InputTextArea class="form-control" @bind-Value="Categoria.Descricao" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Categoria Pai (Opcional)</label>
                    <InputSelect @bind-Value="Categoria.CategoriaPaiId" class="form-select">
                        <option value="">-- Nenhuma (É uma categoria Principal) --</option>
                        @foreach (var cat in ListaPossiveisPais)
                        {
                            <option value="@cat.Id">@cat.Nome</option>
                        }
                    </InputSelect>
                    <div class="form-text">Ex: Se estás a editar "Rock", escolhe "Música" aqui.</div>
                </div>

                <button type="submit" class="btn btn-primary">Atualizar</button>
                <a href="/categorias" class="btn btn-secondary">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromForm]
    public Categoria? Categoria { get; set; }

    // Lista para preencher a dropdown
    private List<Categoria>? ListaPossiveisPais;

    protected override async Task OnInitializedAsync()
    {
        if (Categoria == null)
        {
            // 1. Carregar a categoria que queremos editar
            Categoria = await Context.Categorias.FindAsync(Id);

            if (Categoria == null)
            {
                Navigation.NavigateTo("/categorias");
                return;
            }

            // 2. Carregar todas as OUTRAS categorias para serem possíveis pais
            // (Excluímos a própria categoria para não ser pai dela mesma!)
            ListaPossiveisPais = await Context.Categorias
                .Where(c => c.Id != Id)
                .ToListAsync();
        }
    }

    private async Task AtualizarCategoria()
    {
        if (Categoria != null)
        {
            Context.Categorias.Update(Categoria);
            await Context.SaveChangesAsync();
            Navigation.NavigateTo("/categorias");
        }
    }
}