@page "/admin/utilizadores"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TP.Backend.Data.Entidades
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]

<PageTitle>Gestão de Utilizadores</PageTitle>

<h1>Utilizadores</h1>

@if (ListaUtilizadores == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in ListaUtilizadores)
            {
                <tr>
                    <td>
                        <div class="fw-bold">@user.NomeCompleto</div>
                        <small class="text-muted">NIF: @(user.NIF ?? "N/A")</small>
                    </td>
                    <td>@user.Email</td>
                    <td>
                        <span class="badge bg-info text-dark">@user.Tipo</span>
                    </td>
                    <td>
                        @if (user.Estado == UserStatus.Ativo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendente</span>
                        }
                    </td>
                    <td>
                        @if (user.Estado == UserStatus.Pendente)
                        {
                            <button class="btn btn-sm btn-success me-2" @onclick="() => AlterarEstado(user, UserStatus.Ativo)">
                                Aprovar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-warning me-2" @onclick="() => AlterarEstado(user, UserStatus.Pendente)">
                                Suspender
                            </button>
                        }

                        @if (user.Tipo != UserType.Administrador)
                        {
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => PromoverAdmin(user)">
                                Tornar Admin
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ApplicationUser>? ListaUtilizadores;

    protected override async Task OnInitializedAsync()
    {
        // Carrega todos os utilizadores (menos o próprio admin logado para evitar acidentes, opcional)
        ListaUtilizadores = await UserManager.Users.ToListAsync();
    }

    private async Task AlterarEstado(ApplicationUser user, UserStatus novoEstado)
    {
        user.Estado = novoEstado;
        await UserManager.UpdateAsync(user);
    }

    private async Task PromoverAdmin(ApplicationUser user)
    {
        // 1. Mudar o Tipo
        user.Tipo = UserType.Administrador;
        await UserManager.UpdateAsync(user);

        // 2. Adicionar ao Role do Identity
        if (!await UserManager.IsInRoleAsync(user, "Administrador"))
        {
            await UserManager.AddToRoleAsync(user, "Administrador");
        }
    }
}